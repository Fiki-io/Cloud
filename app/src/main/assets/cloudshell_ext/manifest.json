{
  "manifest_version": 2,
  "name": "CloudShell Bridge",
  "version": "2.0",
  "description": "Terminal DOM and clipboard bridge",
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_end"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@cloudshell.aistudio.com"
    }
  }
}
